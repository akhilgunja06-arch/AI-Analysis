# =============================================================================
# SkillSpring — server environment example
# Copy to server/.env before running the API.
# NEVER commit real credentials. NEVER expose these values to the frontend.
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://skillspring:skillspring_dev@127.0.0.1:5432/skillspring?schema=public"

# --- Server ---
NODE_ENV=development
PORT=4000
# Public base URL of the API (used in emails + OpenAPI server list)
API_PUBLIC_URL="http://localhost:4000"
# Comma-separated list of allowed browser origins (CORS allow-list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Auth / sessions ---
# Generate with: openssl rand -hex 48
ACCESS_TOKEN_SECRET="replace-me-with-64-hex-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# Pepper mixed into password hashes (bcrypt already salts; this is defence in depth)
PASSWORD_PEPPER="replace-me-too"
COOKIE_DOMAIN="localhost"
# Set true when the app is served over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Email delivery (configurable provider) ---
# "console"  -> logs the message (development default, no credentials needed)
# "smtp"     -> sends through SMTP_* below
# "disabled" -> silently drops, endpoints still respond consistently
EMAIL_PROVIDER=console
EMAIL_FROM="SkillSpring <no-reply@skillspring.local>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

# --- Object storage for avatars / attachments ---
# "local" -> writes to UPLOAD_DIR and serves from /uploads (development default)
# "s3"    -> requires the S3_* values below
STORAGE_PROVIDER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=5242880
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Optional AI assistance (skill recommendations / learning plans) ---
# The platform works fully without this. When unset, endpoints that would use a
# model return 501 with an explicit "not configured" message instead of faking it.
AI_PROVIDER=none
AI_API_KEY=""
AI_MODEL=""

# Frontend values live in web/.env.example — the server never reads VITE_* variables.

# --- Tests only ---
# The integration suite refuses to run against DATABASE_URL, so it needs a
# separate database. Leave unset for normal development.
# DATABASE_URL_TEST="postgresql://skillspring:skillspring_dev@127.0.0.1:5432/skillspring_test?schema=public"
