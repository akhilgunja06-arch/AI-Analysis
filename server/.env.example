# =============================================================================
# SkillSpring — server environment example
# Copy to server/.env before running the API.
# NEVER commit real credentials. NEVER expose these values to the frontend.
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://skillspring:skillspring_dev@127.0.0.1:5432/skillspring?schema=public"

# --- Server ---
NODE_ENV=development
PORT=4000
# Public base URL of the API (used in emails + OpenAPI server list)
API_PUBLIC_URL="http://localhost:4000"
# Comma-separated list of allowed browser origins (CORS allow-list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Auth / sessions ---
# Generate with: openssl rand -hex 48
ACCESS_TOKEN_SECRET="replace-me-with-64-hex-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# Pepper mixed into password hashes (bcrypt already salts; this is defence in depth)
PASSWORD_PEPPER="replace-me-too"
COOKIE_DOMAIN="localhost"
# Set true when the app is served over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Email delivery (configurable provider) ---
# "console"  -> logs the message (development default, no credentials needed)
# "smtp"     -> sends through SMTP_* below
# "disabled" -> silently drops, endpoints still respond consistently
EMAIL_PROVIDER=console
EMAIL_FROM="SkillSpring <no-reply@skillspring.local>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

# --- Object storage for avatars / attachments ---
# "local" -> writes to UPLOAD_DIR and serves from /uploads (development default)
# "s3"    -> requires the S3_* values below
STORAGE_PROVIDER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=5242880
# Media limits. Images are optimised before storage; videos are stored byte-for-byte.
MAX_IMAGE_UPLOAD_BYTES=15728640
MAX_VIDEO_UPLOAD_BYTES=209715200
# Lifetime of a signed URL for private media, in seconds.
MEDIA_SIGNED_URL_TTL_SECONDS=900
# How long an unfinished resumable video upload is kept before it is abandoned.
MEDIA_UPLOAD_TTL_MINUTES=120
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Email OTP verification ---
# Accounts stay PENDING_VERIFICATION until the emailed code is entered.
# Set REQUIRE_EMAIL_OTP=false only for a throwaway local database you do not care
# about; production must keep it true.
REQUIRE_EMAIL_OTP=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- AI Study Assistant (Groq) ---
# Create a key at https://console.groq.com/keys and keep it server-side only.
# With GROQ_API_KEY empty the assistant returns 501 AI_NOT_CONFIGURED; it never
# fabricates a reply. Verify the model name against the Groq model list.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.4
GROQ_TIMEOUT_MS=30000
# Requests allowed per member per RATE_LIMIT_WINDOW_MS.
AI_RATE_LIMIT_MAX=30

# --- Legacy AI provider switch (kept for older deployments) ---
# The platform works fully without a model. When unset, endpoints that would use
# one return 501 with an explicit "not configured" message instead of faking it.
AI_PROVIDER=none
AI_API_KEY=""
AI_MODEL=""

# --- WebRTC calling (audio + video) ---
# STUN is enough on most home networks. Calls between restrictive NATs need a
# TURN relay; without one those calls fail to connect rather than silently
# pretending to work. Format: comma-separated stun:/turn:/turns: URLs.
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
WEBRTC_TURN_URLS=""
WEBRTC_TURN_USERNAME=""
WEBRTC_TURN_CREDENTIAL=""
# Optional shared secret for time-limited TURN credentials (coturn "static-auth-secret").
WEBRTC_TURN_STATIC_SECRET=""
WEBRTC_TURN_TTL_SECONDS=3600
# Seconds a ringing call waits before it is treated as missed.
CALL_RING_TIMEOUT_SECONDS=45

# Study-only moderation is always on. Its escalation windows live in
# server/src/services/enforcement.service.ts.

# Frontend values live in web/.env.example — the server never reads VITE_* variables.

# --- Tests only ---
# The integration suite refuses to run against DATABASE_URL, so it needs a
# separate database. Leave unset for normal development.
# DATABASE_URL_TEST="postgresql://skillspring:skillspring_dev@127.0.0.1:5432/skillspring_test?schema=public"
