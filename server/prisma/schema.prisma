// SkillSpring — PostgreSQL schema (Prisma ORM)
// Conventions:
//  * Every table has created_at / updated_at.
//  * Emails are stored lower-cased; usernames are stored lower-cased for uniqueness.
//  * Deleting a user cascades to owned content; references from other users are
//    restricted or nulled so history survives.
//  * Indexes are added for the columns used by list/filter endpoints (pagination).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enumerations

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SkillDirection {
  TEACH
  LEARN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SessionFormat {
  ONLINE
  IN_PERSON
  EITHER
}

enum ExchangeStatus {
  PENDING
  COUNTERED
  ACCEPTED
  ACTIVE
  PAUSED
  COMPLETED
  DECLINED
  WITHDRAWN
  CANCELLED
}

enum ExchangeRole {
  INITIATOR
  RECIPIENT
}

enum ParticipantStatus {
  INVITED
  AGREED
  COMPLETED
  LEFT
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  EXCHANGE_REQUEST
  EXCHANGE_ACCEPTED
  EXCHANGE_DECLINED
  EXCHANGE_COUNTERED
  EXCHANGE_ACTIVE
  EXCHANGE_COMPLETED
  EXCHANGE_CANCELLED
  SESSION_SCHEDULED
  SESSION_UPDATED
  SESSION_CANCELLED
  SESSION_REMINDER
  MESSAGE
  REVIEW_RECEIVED
  FOLLOW
  COMMUNITY_REPLY
  MODERATION
  SYSTEM
}

enum ReportTargetType {
  USER
  MESSAGE
  REVIEW
  COMMUNITY_POST
  COMMUNITY_COMMENT
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  NO_SHOW
  OFF_TOPIC
  FALSE_INFORMATION
  OTHER
}

enum ModerationAction {
  NONE
  CONTENT_HIDDEN
  CONTENT_REMOVED
  WARNING_ISSUED
  USER_SUSPENDED
  USER_REINSTATED
  REPORT_DISMISSED
}

enum PostStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
}

enum CompressionStatus {
  PENDING
  PROCESSING
  OPTIMIZED
  SKIPPED
  FAILED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum UploadStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
  EXPIRED
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  FAILED
}

enum ModerationVerdict {
  ALLOW
  WARN
  BLOCK
}

enum ModerationCategory {
  EDUCATIONAL
  SEXUAL
  HARASSMENT
  THREAT
  SPAM
  ILLEGAL
  OFF_TOPIC
  SELF_HARM
}

// ------------------------------------------------------------------- identity

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  username        String        @unique
  passwordHash    String
  role            Role          @default(MEMBER)
  status          AccountStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  // Updated while a member has a live socket, so a peer can be told when they
  // were last around rather than only whether they are online right now.
  lastSeenAt      DateTime?
  deactivatedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile               Profile?
  preference            UserPreference?
  skills                UserSkill[]
  availability          Availability[]
  sessions              AuthSession[]
  tokens                AuthToken[]
  initiations           ExchangeRequest[]         @relation("ExchangeRequestInitiator")
  receipts              ExchangeRequest[]         @relation("ExchangeRequestRecipient")
  participations        ExchangeParticipant[]
  createdExchanges      Exchange[]                @relation("ExchangeCreatedBy")
  sessionsTaught        Session[]                 @relation("SessionHost")
  conversationParts     ConversationParticipant[]
  messages              Message[]
  notifications         Notification[]
  reviewsWritten        Review[]                  @relation("ReviewAuthor")
  reviewsReceived       Review[]                  @relation("ReviewSubject")
  followers             Follow[]                  @relation("FollowFollower")
  following             Follow[]                  @relation("FollowFollowing")
  posts                 CommunityPost[]
  comments              CommunityComment[]
  postVotes             CommunityPostVote[]
  commentVotes          CommunityCommentVote[]
  reportsMade           Report[]                  @relation("ReportReporter")
  reportsAgainst        Report[]                  @relation("ReportTargetUser")
  blocksMade            UserBlock[]               @relation("BlockBlocker")
  blocksReceived        UserBlock[]               @relation("BlockBlocked")
  auditLogs             AuditLog[]                @relation("AuditActor")
  supportTickets        SupportTicket[]
  milestonesAuthored    Milestone[]               @relation("MilestoneAuthor")
  exchangeNotes         ExchangeNote[]            @relation("ExchangeNoteAuthor")
  mediaAssets           MediaAsset[]
  uploadSessions        MediaUploadSession[]
  favoritesMade         Favorite[]                @relation("FavoriteOwner")
  favoritedBy           Favorite[]                @relation("FavoriteTarget")
  aiConversations       AiConversation[]
  aiMessages            AiMessage[]
  moderationEvents      ModerationEvent[]         @relation("ModerationSubject")
  messagingRestrictions MessagingRestriction[]    @relation("RestrictionUser")
  callsInitiated        CallSession[]             @relation("CallCaller")
  callsReceived         CallSession[]             @relation("CallCallee")
  location              UserLocation?

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

model Profile {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @unique @db.Uuid
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName             String
  headline                String?
  bio                     String?       @db.Text
  avatarUrl               String?
  location                String?
  timezone                String        @default("UTC")
  languages               String[]      @default([])
  websiteUrl              String?
  githubUrl               String?
  linkedinUrl             String?
  preferredFormat         SessionFormat @default(ONLINE)
  learningGoals           String?       @db.Text
  weeklyAvailabilityHours Int?
  onboardingCompletedAt   DateTime?
  onboardingStep          Int           @default(1)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([location])
  @@index([timezone])
}

model UserPreference {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @db.Uuid
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // profile visibility
  publicProfile          Boolean  @default(true)
  showEmail              Boolean  @default(false)
  showLocation           Boolean  @default(true)
  showLanguages          Boolean  @default(true)
  showAvailability       Boolean  @default(true)
  showCompletedExchanges Boolean  @default(true)
  allowExchangeRequests  Boolean  @default(true)
  allowMessagesFrom      String   @default("MEMBERS") // MEMBERS | FOLLOWING | NOBODY
  // notification channel preferences
  emailOnExchange        Boolean  @default(true)
  emailOnMessage         Boolean  @default(false)
  emailOnSession         Boolean  @default(true)
  emailOnReview          Boolean  @default(true)
  emailOnCommunity       Boolean  @default(false)
  inAppOnEverything      Boolean  @default(true)
  weeklyDigest           Boolean  @default(true)
  reducedMotion          Boolean  @default(false)
  theme                  String   @default("system") // light | dark | system
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Refresh tokens are stored as SHA-256 hashes, never in plaintext.
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  PASSWORD_RESET
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, purpose])
}

// --------------------------------------------------------------------- skills

model SkillCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String   @unique
  description String?
  icon        String? // lucide icon name used by the frontend
  color       String? // hex colour used for chips and cards
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills Skill[]
  posts  CommunityPost[]

  @@index([sortOrder])
  @@index([isActive, sortOrder])
}

model Skill {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String        @unique
  description String?
  categoryId  String        @db.Uuid
  category    SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userSkills          UserSkill[]
  communityPosts      CommunityPost[]   @relation("CommunityPostSkill")
  offeredInRequests   ExchangeRequest[] @relation("RequestOfferedSkill")
  requestedInRequests ExchangeRequest[] @relation("RequestRequestedSkill")

  @@index([categoryId])
  @@index([name])
}

model UserSkill {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String         @db.Uuid
  skill           Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  direction       SkillDirection
  level           SkillLevel     @default(INTERMEDIATE)
  description     String?        @db.Text
  outcomes        String?        @db.Text
  portfolioUrl    String?
  yearsExperience Int?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // One row per user/skill/direction: duplicate detection is a DB constraint.
  @@unique([userId, skillId, direction])
  @@index([skillId, direction, isActive])
  @@index([userId, direction])
}

model Availability {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 0 = Sunday … 6 = Saturday (matches JS Date.getDay())
  weekday     Int
  startMinute Int // minutes from midnight, local to the user's timezone
  endMinute   Int
  format      SessionFormat @default(ONLINE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, weekday])
}

// ------------------------------------------------------------------ exchanges

model ExchangeRequest {
  id               String            @id @default(uuid()) @db.Uuid
  initiatorId      String            @db.Uuid
  initiator        User              @relation("ExchangeRequestInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipientId      String            @db.Uuid
  recipient        User              @relation("ExchangeRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  // skill the initiator will teach / wants to learn
  offeredSkillId   String?           @db.Uuid
  offeredSkill     Skill?            @relation("RequestOfferedSkill", fields: [offeredSkillId], references: [id], onDelete: SetNull)
  requestedSkillId String?           @db.Uuid
  requestedSkill   Skill?            @relation("RequestRequestedSkill", fields: [requestedSkillId], references: [id], onDelete: SetNull)
  message          String?           @db.Text
  goals            String?           @db.Text
  sessionMinutes   Int               @default(60)
  sessionsPerWeek  Int               @default(1)
  totalSessions    Int               @default(6)
  preferredFormat  SessionFormat     @default(ONLINE)
  status           ExchangeStatus    @default(PENDING)
  // Set when this request is a counter-proposal: points at the request it answers.
  parentRequestId  String?           @db.Uuid
  parentRequest    ExchangeRequest?  @relation("RequestCounter", fields: [parentRequestId], references: [id], onDelete: SetNull)
  counters         ExchangeRequest[] @relation("RequestCounter")
  respondedAt      DateTime?
  exchangeId       String?           @db.Uuid
  exchange         Exchange?         @relation(fields: [exchangeId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([recipientId, status])
  @@index([initiatorId, status])
  @@index([createdAt])
}

model Exchange {
  id                 String         @id @default(uuid()) @db.Uuid
  title              String
  createdById        String         @db.Uuid
  createdBy          User           @relation("ExchangeCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  status             ExchangeStatus @default(ACTIVE)
  goals              String?        @db.Text
  sessionMinutes     Int            @default(60)
  totalSessions      Int            @default(6)
  preferredFormat    SessionFormat  @default(ONLINE)
  // credit model support: credits transferred when an exchange completes
  creditValue        Int            @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  pausedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  participants ExchangeParticipant[]
  milestones   Milestone[]
  notes        ExchangeNote[]
  sessions     Session[]
  reviews      Review[]
  requests     ExchangeRequest[]
  events       ExchangeEvent[]

  @@index([status])
  @@index([createdAt])
}

model ExchangeParticipant {
  id             String            @id @default(uuid()) @db.Uuid
  exchangeId     String            @db.Uuid
  exchange       Exchange          @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  userId         String            @db.Uuid
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ExchangeRole      @default(INITIATOR)
  status         ParticipantStatus @default(INVITED)
  // what this participant teaches / learns inside this exchange
  teachesSkillId String?           @db.Uuid
  learnsSkillId  String?           @db.Uuid
  agreedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([exchangeId, userId])
  @@index([userId, status])
}

model ExchangeNote {
  id          String   @id @default(uuid()) @db.Uuid
  exchangeId  String   @db.Uuid
  exchange    Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  authorId    String   @db.Uuid
  author      User     @relation("ExchangeNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  resourceUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([exchangeId, createdAt])
}

model Milestone {
  id          String          @id @default(uuid()) @db.Uuid
  exchangeId  String          @db.Uuid
  exchange    Exchange        @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  authorId    String          @db.Uuid
  author      User            @relation("MilestoneAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([exchangeId, status])
}

model Session {
  id                 String        @id @default(uuid()) @db.Uuid
  exchangeId         String        @db.Uuid
  exchange           Exchange      @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  hostId             String        @db.Uuid
  host               User          @relation("SessionHost", fields: [hostId], references: [id], onDelete: Cascade)
  title              String?
  agenda             String?       @db.Text
  notes              String?       @db.Text
  startsAt           DateTime
  endsAt             DateTime
  timezone           String        @default("UTC")
  format             SessionFormat @default(ONLINE)
  meetingUrl         String?
  location           String?
  status             SessionStatus @default(SCHEDULED)
  reminderSentAt     DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledById      String?       @db.Uuid
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([exchangeId, startsAt])
  @@index([hostId, startsAt])
  @@index([startsAt, status])
}

// Human-readable audit trail of an exchange lifecycle, shown as the timeline UI.
model ExchangeEvent {
  id         String   @id @default(uuid()) @db.Uuid
  exchangeId String   @db.Uuid
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  actorId    String?  @db.Uuid
  type       String // e.g. "exchange.created", "session.completed"
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([exchangeId, createdAt])
}

// ---------------------------------------------------------------- messaging

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  // deterministic key for 1:1 conversations so duplicates cannot be created
  directKey     String?  @unique
  isGroup       Boolean  @default(false)
  title         String?
  exchangeId    String?  @db.Uuid
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  muted          Boolean      @default(false)
  blocked        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  conversationId    String       @db.Uuid
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String       @db.Uuid
  sender            User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body              String       @db.Text
  attachmentUrl     String?
  attachmentName    String?
  attachmentType    String?
  attachmentMediaId String?      @db.Uuid
  attachmentMedia   MediaAsset?  @relation("MessageAttachment", fields: [attachmentMediaId], references: [id], onDelete: SetNull)
  // simple moderation flag; hidden messages stay in the DB for audit purposes
  hiddenAt          DateTime?
  hiddenById        String?      @db.Uuid
  // Set when the message reached the recipient's account, and when they opened
  // the conversation. The sender's own copy is always "sent".
  deliveredAt       DateTime?
  readAt            DateTime?
  // Set by the sender when they delete their own message; the row is kept so
  // the other side sees a tombstone instead of history silently changing.
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, readAt])
}

// ------------------------------------------------------------- notifications

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  metadata  Json?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, readAt, createdAt])
}

// ------------------------------------------------------------------- reviews

model Review {
  id                  String    @id @default(uuid()) @db.Uuid
  exchangeId          String    @db.Uuid
  exchange            Exchange  @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  authorId            String    @db.Uuid
  author              User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId           String    @db.Uuid
  subject             User      @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  rating              Int
  teachingRating      Int?
  communicationRating Int?
  reliabilityRating   Int?
  comment             String?   @db.Text
  hiddenAt            DateTime?
  hiddenById          String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // One review per author per exchange; self-reviews blocked in service layer + check constraint below.
  @@unique([exchangeId, authorId])
  @@index([subjectId, createdAt])
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @db.Uuid
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ----------------------------------------------------------------- community

model CommunityPost {
  id           String         @id @default(uuid()) @db.Uuid
  authorId     String         @db.Uuid
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId   String?        @db.Uuid
  category     SkillCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  skillId      String?        @db.Uuid
  skill        Skill?         @relation("CommunityPostSkill", fields: [skillId], references: [id], onDelete: SetNull)
  title        String
  body         String         @db.Text
  postType     String         @default("DISCUSSION") // DISCUSSION | QUESTION | RESOURCE
  resourceUrl  String?
  status       PostStatus     @default(PUBLISHED)
  pinned       Boolean        @default(false)
  commentCount Int            @default(0)
  voteCount    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  comments CommunityComment[]
  votes    CommunityPostVote[]

  @@index([createdAt])
  @@index([categoryId, createdAt])
  @@index([status])
}

model CommunityComment {
  id        String             @id @default(uuid()) @db.Uuid
  postId    String             @db.Uuid
  post      CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String             @db.Uuid
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?            @db.Uuid
  parent    CommunityComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[] @relation("CommentThread")
  body      String             @db.Text
  isAnswer  Boolean            @default(false)
  voteCount Int                @default(0)
  status    PostStatus         @default(PUBLISHED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  votes CommunityCommentVote[]

  @@index([postId, createdAt])
  @@index([authorId])
}

model CommunityPostVote {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @db.Uuid
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int           @default(1) // 1 = helpful/up, -1 = down
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([postId, userId])
}

model CommunityCommentVote {
  id        String           @id @default(uuid()) @db.Uuid
  commentId String           @db.Uuid
  comment   CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([commentId, userId])
}

// --------------------------------------------------- moderation & trust/safety

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @db.Uuid
  reporter       User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTargetType
  targetUserId   String?          @db.Uuid
  targetUser     User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetId       String?          @db.Uuid
  reason         ReportReason
  details        String?          @db.Text
  status         ReportStatus     @default(OPEN)
  resolutionNote String?
  actionTaken    ModerationAction @default(NONE)
  handledById    String?          @db.Uuid
  handledAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// --------------------------------------------------------- admin / compliance

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "user.suspended", "skill_category.created"
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------- media

/// Metadata for a user's uploaded image or video. The bytes live in object
/// storage; only the storage path, dimensions and sizes are recorded here.
/// The original upload is always retained in `originalStoragePath` so an
/// optimisation failure can never destroy it.
model MediaAsset {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType           MediaType
  bucket              String // logical bucket: user-images | user-videos | message-attachments | profile-images
  originalFileName    String
  storagePath         String // path of the served (optimised, or original for video) object
  originalStoragePath String? // path of the untouched upload, kept for recovery
  thumbnailPath       String?
  originalSizeBytes   BigInt
  storedSizeBytes     BigInt
  mimeType            String
  originalMimeType    String
  fileExtension       String
  width               Int?
  height              Int?
  durationSeconds     Float?
  frameRate           Float?
  bitRate             Int?
  checksumSha256      String? // of the original upload, so video integrity is verifiable
  compressionStatus   CompressionStatus @default(PENDING)
  processingStatus    ProcessingStatus  @default(PENDING)
  visibility          MediaVisibility   @default(PRIVATE)
  errorMessage        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  messageAttachments Message[] @relation("MessageAttachment")

  @@index([userId, createdAt])
  @@index([userId, mediaType])
  @@index([processingStatus])
}

/// Tracks a chunked/resumable upload so a large video survives a dropped
/// connection and cannot be stored twice for the same client upload id.
model MediaUploadSession {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientUploadId   String
  mediaType        MediaType
  bucket           String
  originalFileName String
  mimeType         String
  totalBytes       BigInt
  receivedBytes    BigInt       @default(0)
  chunkCount       Int          @default(0)
  status           UploadStatus @default(IN_PROGRESS)
  storagePath      String? // temp path where chunks are assembled
  assetId          String? // set once the upload is finalised
  expiresAt        DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // One session per (user, client upload id): retries reuse it, no duplicates.
  @@unique([userId, clientUploadId])
  @@index([userId, status])
  @@index([expiresAt])
}

// ------------------------------------------------------------------ favorites

model Favorite {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation("FavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  favoriteUserId String   @db.Uuid
  favoriteUser   User     @relation("FavoriteTarget", fields: [favoriteUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([userId, favoriteUserId])
  @@index([userId, createdAt])
  @@index([favoriteUserId])
}

// ----------------------------------------------------------------- AI chat

/// A member's saved location, stored only with explicit consent.
///
/// Exact coordinates never leave the server: `nearby` queries run here and the
/// API returns a grid-snapped point (about 1 km) plus a place label. The member
/// controls whether anything is shared at all via `sharingEnabled`.
model UserLocation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  /// Human-readable place name from reverse geocoding or manual entry.
  label          String?
  city           String?
  region         String?
  country        String?
  /// When false the member still sees their own pin but nobody else does.
  sharingEnabled Boolean  @default(false)
  /// When the member last consented to storing a location. Cleared on removal.
  consentAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sharingEnabled, latitude, longitude])
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           AiRole
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ------------------------------------------------------- chat moderation

/// One row per moderation decision that did not simply allow a message.
/// Message bodies are referenced by id, not copied, so the audit trail never
/// becomes a second store of private conversation content.
model ModerationEvent {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  user        User               @relation("ModerationSubject", fields: [userId], references: [id], onDelete: Cascade)
  // Where the content came from: MESSAGE | AI_PROMPT | COMMUNITY
  surface     String             @default("MESSAGE")
  messageId   String?            @db.Uuid
  verdict     ModerationVerdict
  category    ModerationCategory
  severity    Int                @default(1)
  // Short, non-content explanation of why the decision was made.
  reason      String
  // Hash of the offending text so repeated identical abuse can be correlated
  // without storing the text itself.
  contentHash String?
  createdAt   DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([verdict, createdAt])
}

/// An active restriction placed on an account by the moderation pipeline.
/// `expiresAt` null means it lasts until a human lifts it.
model MessagingRestriction {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation("RestrictionUser", fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  severity  Int       @default(1)
  expiresAt DateTime?
  liftedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, expiresAt])
}

// ------------------------------------------------------------------ WebRTC calls

/// Signalling metadata for a one-to-one audio/video call. Media never touches
/// the server: the row exists so both parties can be authorised, so an incoming
/// call can be delivered to the right socket room, and so call history is real.
model CallSession {
  id              String     @id @default(uuid()) @db.Uuid
  callerId        String     @db.Uuid
  caller          User       @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId        String     @db.Uuid
  callee          User       @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  type            CallType
  status          CallStatus @default(RINGING)
  startedAt       DateTime   @default(now())
  acceptedAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  endedById       String?    @db.Uuid
  // Short explanation for a non-normal end (rejected, missed, failed).
  endReason       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([status])
}
