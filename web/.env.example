# Browser-safe values only. NEVER put secrets in frontend environment variables.
# Leave both unset to use the page origin, which the Vite dev server proxies to
# the API (see vite.config.ts). Only set these when the API is served from a
# different origin than the front end, and never hardcode http://localhost:4000:
# it is unreachable from any browser that is not on the API host itself.
VITE_API_URL="/api"
VITE_SOCKET_URL=""
